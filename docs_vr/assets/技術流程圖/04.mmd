flowchart TD
  returning["任務達成或 SAN 達限制<br/>進入 Return／停止捕捉"]
  reach["玩家在站旁＋虛擬捕捉器<br/>進入回收站感應範圍"]
  check{"本場處於可回收階段？"}
  deny["不授權<br/>維持提示"]
  auth["station_visited = true<br/>可移開，再按控制器確認"]
  request["RECYCLE_REQUEST<br/>檢查到站／尚未回收／追蹤"]
  commit["先標記已回收／固定清單<br/>登錄種類與群落數量"]
  convert["噪音能量轉化為物品<br/>VR 城市修復演出"]
  result["結尾／固定成果快照<br/>接圖 05 保存與交付"]
  returning --> reach
  reach --> check
  check -->|"否"| deny
  check -->|"是"| auth
  auth --> request
  request -->|"通過"| commit
  request -->|"不通過"| deny
  commit --> convert
  convert --> result
