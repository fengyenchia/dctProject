  tagRead --> seatReport --> deviceMap --> checkPresence
  checkPresence -->|"否"| rejectRead
  checkPresence -->|"是"| issueAuthorization --> authorizationUi
  authorizationUi -->|"移開後資格仍保留"| confirmButton
  confirmButton --> recycleRequest --> validateAuthorization
  validateAuthorization -->|"否"| rejectRequest
  validateAuthorization -->|"是：尚未結算"| commitRecycle
  commitRecycle --> repairDisplay
  commitRecycle --> resultSnapshot
  style issueAuthorization fill:#C2E5FF,stroke:#3DADFF
  style commitRecycle fill:#CDF4D3,stroke:#66D575
  style rejectRequest fill:#FFCDC2,stroke:#FF7556
