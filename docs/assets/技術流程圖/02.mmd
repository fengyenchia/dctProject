flowchart LR
  irSample["固定點紅外線編碼"]
  sensorRead["PAJ7025R3 光點取樣"]
  decodePoint["ESP32 解碼與中心偏移"]
  observation["Gateway 轉送觀測"]
  validateTarget{"場次／群落／瞄準有效？"}
  pauseCapture["Unity 暫停累積／保留群落進度"]
  hideMask["投影隱藏 Mask 與進度"]
  pausedDisplay["LCD 顯示暫停／保留原進度"]
  captureInterrupted["失去目標／斷線／回收引導"]
  sameTarget{"仍對準同一群落？"}
  loadProgress["載入該群既有進度／新群落起始為 0"]
  showMask["Unity 在固定點顯示 Mask"]
  maskProgress["投影更新 Mask 與捕捉進度"]
  finishMask["成功後清除該群暫存／收起 Mask"]
  progress["Unity 累積該群有效時間"]
  durationReached{"累積有效時間達標？"}
  feedback["CAPTURE_PROGRESS 回傳裝置"]
  commitCapture["整群收走／停燈／SAN 扣一次"]
  captureResult["CAPTURE_RESULT 回傳裝置"]
  deviceOutput["LCD／震動成功回饋"]
  noiseEvent["觸發捕捉器噪音事件"]
  groupEnded["群落消失／本場結束或重置"]
  discardProgress["清除對應群落進度／新群落不繼承"]
  irSample --> sensorRead --> decodePoint --> observation --> validateTarget
  validateTarget -->|"否：移開或資料無效"| pauseCapture
  pauseCapture --> hideMask --> pausedDisplay
  captureInterrupted --> pauseCapture
  validateTarget -->|"是"| sameTarget
  sameTarget -->|"否：首次或換目標"| loadProgress
  loadProgress --> showMask --> progress
  sameTarget -->|"是"| progress
  progress --> durationReached
  progress -->|"同一份 Unity 進度"| maskProgress
  durationReached -->|"否"| feedback
  feedback -.->|"繼續取樣"| sensorRead
  durationReached -->|"是：累積達標且群落有效"| commitCapture
  commitCapture --> finishMask --> captureResult --> deviceOutput
  commitCapture --> noiseEvent
  groupEnded --> discardProgress
